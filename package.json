{
  "name": "untab",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "test:native": "node qa/run-native.mjs",
    "check": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiocos/untab.git"
  }
}
